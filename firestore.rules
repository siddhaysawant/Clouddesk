rules_version = '2';

// CloudDesk Firestore Security Rules
// Each signed-in Google user can only read/write their own document,
// keyed by their Firebase Auth UID. No one can read or write another
// user's data, and unauthenticated requests are rejected entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    match /clouddesk_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
